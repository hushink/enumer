{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/hushink/enumer/main/schema/enumer.schema.json",
  "title": "enumer manifest",
  "description": "Schema for enumer.yaml, the single source of truth for type-safe Go enums generated by enumer.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema URL used by editors for completion and validation. enumer ignores this field."
    },
    "version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Manifest schema version. Only 1 is supported; omitted means 1."
    },
    "extends": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a base manifest whose defaults are inherited. Only defaults are inherited."
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "description": "Go package name. Inferred from the directory's Go files when omitted."
    },
    "aggregate": {
      "type": "boolean",
      "default": false,
      "description": "Emit every enum of this manifest into one file."
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "Aggregate output path, relative to the manifest. Only valid when aggregate is true."
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "enums": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/enum"
      },
      "description": "Enum declarations. At least one is required for generation; base manifests used only by extends may omit this field."
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/target"
      },
      "description": "Custom text/template outputs."
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "aggregate": {
              "const": true
            }
          },
          "required": [
            "aggregate"
          ]
        }
      },
      "then": {
        "not": {
          "required": [
            "output"
          ]
        }
      }
    }
  ],
  "definitions": {
    "underlyingType": {
      "type": "string",
      "enum": [
        "string",
        "int",
        "int8",
        "int16",
        "int32",
        "int64",
        "uint",
        "uint8",
        "uint16",
        "uint32",
        "uint64"
      ],
      "description": "Go underlying type of the enum."
    },
    "numericType": {
      "type": "string",
      "enum": [
        "int",
        "int8",
        "int16",
        "int32",
        "int64",
        "uint",
        "uint8",
        "uint16",
        "uint32",
        "uint64"
      ],
      "description": "A signed or unsigned integer type."
    },
    "feature": {
      "type": "string",
      "enum": [
        "string",
        "parse",
        "valid",
        "flags",
        "mustparse",
        "text",
        "json",
        "json:number",
        "yaml",
        "sql",
        "sql:int",
        "sql:null",
        "flag",
        "names",
        "values",
        "ptr"
      ],
      "description": "A built-in generation feature."
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings shared by every enum in this manifest.",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/feature"
          },
          "default": [
            "string",
            "parse",
            "valid",
            "text",
            "names",
            "values"
          ],
          "description": "Base feature set. Omit for the built-in default; an explicit empty list disables all features. json is mutually exclusive with json:number, and sql with sql:int."
        },
        "disableFeatures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/feature"
          },
          "default": [],
          "description": "Features removed from the base set. Disabling sql also removes sql:int and sql:null; disabling json also removes json:number."
        },
        "naming": {
          "$ref": "#/definitions/naming"
        },
        "parse": {
          "$ref": "#/definitions/parse"
        },
        "output": {
          "$ref": "#/definitions/output"
        },
        "comments": {
          "type": "string",
          "enum": [
            "auto",
            "none"
          ],
          "default": "auto",
          "description": "auto generates documentation comments; none suppresses automatic comments but keeps user comments and deprecation notices."
        },
        "allowDuplicateValues": {
          "type": "boolean",
          "default": false,
          "description": "Permit several names for the same numeric value."
        },
        "typeMode": {
          "type": "string",
          "enum": [
            "auto",
            "emit",
            "existing"
          ],
          "default": "auto",
          "description": "auto emits the type when missing and reuses an existing declaration; emit always emits; existing never emits and requires a matching declaration."
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "description": "Identifier generation settings.",
      "properties": {
        "prefix": {
          "oneOf": [
            {
              "const": "type"
            },
            {
              "const": "none"
            },
            {
              "type": "string",
              "pattern": "^literal:.+$"
            }
          ],
          "default": "type",
          "description": "Constant prefix: type (enum name), none, or literal:<text>."
        },
        "identifier": {
          "type": "string",
          "enum": [
            "camel",
            "raw"
          ],
          "default": "camel",
          "description": "camel converts value names to CamelCase; raw keeps them unchanged and requires valid Go identifiers."
        },
        "extraInitialisms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Additional words to render in all caps, for example GRPC."
        },
        "disableInitialisms": {
          "type": "boolean",
          "default": false,
          "description": "Disable the built-in initialism list (HTTP, URL, ID, ...)."
        }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parsing behavior.",
      "properties": {
        "caseSensitive": {
          "type": "boolean",
          "default": true,
          "description": "When false, parsing and alias matching ignore case; value texts that differ only by case are rejected."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-enum output layout.",
      "properties": {
        "suffix": {
          "type": "string",
          "minLength": 1,
          "default": "_enum.go",
          "description": "Suffix for per-enum output files. .go is appended when missing."
        },
        "dir": {
          "type": "string",
          "default": "",
          "description": "Directory for per-enum output files, relative to the manifest directory."
        }
      }
    },
    "enum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Go type name. Must be a valid Go identifier."
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/definitions/underlyingType"
            }
          ],
          "default": "string",
          "description": "Underlying Go type. Defaults to string."
        },
        "doc": {
          "type": "string",
          "description": "Documentation comment for the type."
        },
        "comment": {
          "type": "string",
          "description": "Comment override; wins over doc."
        },
        "comments": {
          "type": "string",
          "enum": [
            "auto",
            "none"
          ],
          "description": "Per-enum comment mode. Inherits defaults.comments when omitted."
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "description": "Per-enum package override. Requires an explicit output unless the manifest is aggregate."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Per-enum output path relative to the manifest. Must end in .go."
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/feature"
          },
          "description": "Features added to the resolved defaults."
        },
        "disableFeatures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/feature"
          },
          "description": "Features removed from the resolved defaults."
        },
        "typeMode": {
          "type": "string",
          "enum": [
            "auto",
            "emit",
            "existing"
          ],
          "description": "Per-enum override of defaults.typeMode."
        },
        "start": {
          "type": "integer",
          "description": "Initial value for numeric auto-incrementing. Not valid for string enums."
        },
        "allowDuplicateValues": {
          "type": "boolean",
          "description": "Per-enum override of defaults.allowDuplicateValues."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/value"
          },
          "description": "Enum values in declaration order."
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "$ref": "#/definitions/numericType"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "start"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "$ref": "#/definitions/numericType"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "required": [
                      "number"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/valueObject"
        }
      ]
    },
    "valueObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Value name as written in the manifest."
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "String enums: canonical text (defaults to name). Numeric enums: the integer value (defaults to auto-increment)."
        },
        "number": {
          "type": "integer",
          "description": "Integer storage used by sql:int on string enums. Required for every value when sql:int is enabled."
        },
        "doc": {
          "type": "string",
          "description": "Documentation comment for the generated constant."
        },
        "comment": {
          "type": "string",
          "description": "Comment override; wins over doc."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional parseable texts. Aliases do not generate constants."
        },
        "deprecated": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "description": "Adds a Go Deprecated comment. true uses the default reason; a string is the reason."
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "output"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a text/template file, relative to the manifest directory."
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Output path template, relative to the manifest directory. May reference template data."
        },
        "perEnum": {
          "type": "boolean",
          "default": false,
          "description": "Execute the template once per enum instead of once per manifest."
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "package": "order",
      "enums": [
        {
          "name": "Status",
          "type": "string",
          "values": [
            "pending",
            "paid",
            "shipped"
          ]
        }
      ]
    }
  ]
}
